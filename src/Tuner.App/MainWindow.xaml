<Window x:Class="Tuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tuner.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Tuner — 分组音频闪避" Width="920" Height="866"
        MinWidth="800" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <ContextMenu x:Key="DeviceMenu" Placement="Bottom" />
    </Window.Resources>
    <Grid Margin="{DynamicResource M.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏（浮于窗口底，内容面板悬浮其下） -->
        <DockPanel Grid.Row="0" Margin="2,0,2,14" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tuner" FontSize="{DynamicResource Fz.Brand}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{DynamicResource S.App.Subtitle}" FontSize="{DynamicResource Fz.Base}" Foreground="{DynamicResource TextFaint}"
                           VerticalAlignment="Bottom" Margin="9,0,0,3" />
            </StackPanel>
            <controls:LedMeter DockPanel.Dock="Right" x:Name="MasterMeter" Width="110" Height="8" Segments="14"
                               VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{DynamicResource S.Tooltip.MasterPeak}" />
            <Button DockPanel.Dock="Right" x:Name="DeviceButton" Style="{DynamicResource Btn}"
                    HorizontalContentAlignment="Stretch" Padding="11,4" Margin="0,0,10,0"
                    VerticalAlignment="Center" Click="OnDeviceButtonClicked"
                    ToolTip="{DynamicResource S.Tooltip.SwitchDevice}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Green}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceText" Margin="7,0,0,0" FontSize="{DynamicResource Fz.Small}"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Micro}" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- 暂停徽章：仅在闪避暂停期间出现（用户主动开启的状态才占顶栏位置） -->
            <Border DockPanel.Dock="Right" x:Name="PausedChip" CornerRadius="{DynamicResource Rad.Chip}" Padding="9,3" Margin="0,0,10,0"
                    Background="{DynamicResource AmberSoft}" BorderBrush="{DynamicResource AmberBadgeBorder}"
                    BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed"
                    ToolTip="{DynamicResource S.PausedBadgeTip}">
                <TextBlock Text="{DynamicResource S.PausedBadge}" FontSize="{DynamicResource Fz.Small}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AmberText}" />
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

            <!-- ═══ 实时状态 ═══ -->
            <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Tab.Status}" Margin="9,0,0,0" />
                        </StackPanel>
                    </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 统计条：一条内嵌井，三项统计以发丝线分隔 -->
                    <Border Grid.Row="0" Background="{DynamicResource ItemBg}" CornerRadius="{DynamicResource Rad.Card}"
                            Padding="14,8" Margin="2,0,0,10" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.Stat.Sessions}" Style="{DynamicResource Label}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                <TextBlock x:Name="StatTotal" FontSize="{DynamicResource Fz.Stat}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Rectangle Width="1" Fill="{DynamicResource CardBorder}" Margin="14,1" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Green}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.Stat.Speaking}" Style="{DynamicResource Label}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                <TextBlock x:Name="StatSpeaking" FontSize="{DynamicResource Fz.Stat}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Rectangle Width="1" Fill="{DynamicResource CardBorder}" Margin="14,1" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Amber}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.Stat.Ducking}" Style="{DynamicResource Label}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                <TextBlock x:Name="StatDucking" FontSize="{DynamicResource Fz.Stat}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="StatusList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 抬升行：色条 → 图标 → 名称+分组 → 峰值 → 音量% → 状态徽章（数字优先，装饰归零） -->
                                        <Border Background="{DynamicResource ItemBg}"
                                                CornerRadius="{DynamicResource Rad.Card}" Padding="0" Margin="0,0,4,8"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 通道色条：出声时点亮为分组色 -->
                                                <Border Grid.Column="0" Background="{Binding GroupBrush}"
                                                        Opacity="{Binding StripOpacity}" />
                                                <Grid Grid.Column="1" Margin="{DynamicResource M.Item}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="118" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{DynamicResource Rad.Control}"
                                                            Background="{DynamicResource PageBg}" VerticalAlignment="Center" Margin="0,0,11,0">
                                                        <Grid>
                                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}"
                                                                       Foreground="{DynamicResource TextFaint}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Icon}" Width="22" Height="22"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding SpeakingBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding Process}" FontSize="{DynamicResource Fz.Stat}"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding GroupName}" FontSize="{DynamicResource Fz.Micro}"
                                                                   Foreground="{DynamicResource TextFaint}" Margin="15,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource S.Status.Peak}" FontSize="{DynamicResource Fz.Micro}"
                                                                   Foreground="{DynamicResource TextFaint}" />
                                                        <controls:LedMeter Height="10" Segments="12" Margin="0,3,10,0"
                                                                           Value="{Binding PeakPercent}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{Binding VolumeText}" FontSize="{DynamicResource Fz.Num}"
                                                               FontFamily="Consolas" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" />

                                                    <Border Grid.Column="4" Background="{DynamicResource AmberSoft}"
                                                            BorderBrush="{DynamicResource AmberBadgeBorder}" BorderThickness="1"
                                                            CornerRadius="{DynamicResource Rad.Chip}"
                                                            Padding="8,3" VerticalAlignment="Center" Margin="12,0,2,0"
                                                            Visibility="{Binding DuckVisibility}">
                                                        <TextBlock Text="{Binding DuckText}" FontSize="{DynamicResource Fz.Micro}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AmberText}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="StatusEmpty" Text="{DynamicResource S.Status.Empty}"
                                       HorizontalAlignment="Center" Margin="0,60,0,0" Style="{DynamicResource Hint}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══ 音量（输出混音台） ═══ -->
            <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Tab.Volume}" Margin="9,0,0,0" />
                        </StackPanel>
                    </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="OutputTitle" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="2,0,0,10" />

                    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="14,12" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,12" ToolTip="{DynamicResource S.Mixer.Hint}">
                                <TextBlock Text="{DynamicResource S.Mixer.Title}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer x:Name="ChannelsScroller"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="OnChannelsMouseWheel">
                                <StackPanel Orientation="Horizontal">
                                    <!-- MASTER 通道（调音台主输出）：井内凹陷 + 琥珀描边点出主输出身份 -->
                                    <Border Width="112" Background="{DynamicResource PageBg}"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Rad.Card}" Padding="10,10" Margin="0,0,10,4">
                                        <StackPanel>
                                            <!-- 与应用通道的图标区等高（34+8），保证下方各段跨通道对齐 -->
                                            <Border Height="42">
                                                <TextBlock Text="MASTER" FontSize="{DynamicResource Fz.Micro}" FontWeight="Bold" FontFamily="Consolas"
                                                           Foreground="{DynamicResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource S.Mixer.MasterDevice}" FontSize="{DynamicResource Fz.Small}" Height="32"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextAlignment="Center" />
                                            <controls:LedMeter Height="110" Width="14" Orientation="Vertical" Segments="16"
                                                               x:Name="MasterMeterBig" HorizontalAlignment="Center"
                                                               ToolTip="{DynamicResource S.Tooltip.MasterPeak}" />
                                            <Grid Margin="{DynamicResource M.Row}" HorizontalAlignment="Center">
                                                <Slider x:Name="MasterSlider" Style="{DynamicResource FaderV}" Height="130"
                                                        Orientation="Vertical" Minimum="0" Maximum="100"
                                                        MouseEnter="OnChannelFaderMouseEnter"
                                                        MouseLeave="OnChannelFaderMouseLeave"
                                                        PreviewMouseWheel="OnMasterFaderMouseWheel"
                                                        HorizontalAlignment="Center" ValueChanged="OnMasterVolumeChanged" />
                                            </Grid>
                                            <TextBlock x:Name="MasterVolText" FontFamily="Consolas" FontSize="{DynamicResource Fz.Small}"
                                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" />
                                            <Button x:Name="MasterMuteBtn" Content="{DynamicResource S.Mixer.Mute}" Width="76" Margin="0,8,0,0"
                                                    Style="{DynamicResource Btn}" Click="OnMasterMuteClick" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl x:Name="VolumeList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="112" Background="{DynamicResource PageBg}"
                                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource Rad.Card}" Padding="10,10" Margin="0,0,10,4">
                                                    <StackPanel>
                                                        <Border Width="34" Height="34" CornerRadius="{DynamicResource Rad.Card}"
                                                                Background="{DynamicResource ItemBg}"
                                                                HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Grid>
                                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}"
                                                                           Foreground="{DynamicResource TextFaint}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <!-- 固定高度名称区，跨通道对齐 -->
                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fz.Small}" FontWeight="SemiBold"
                                                                   Height="32" Foreground="{DynamicResource TextPrimary}"
                                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <controls:LedMeter Height="110" Width="14" Orientation="Vertical"
                                                                           Segments="16" Value="{Binding PeakPercent}"
                                                                           HorizontalAlignment="Center" />
                                                        <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                                                            <!-- 凹陷滑轨槽：鼠标悬停于滑轨区时浮现 -->
                                                            <Border x:Name="FaderGroove" Width="30" CornerRadius="{DynamicResource Rad.Card}"
                                                                    Background="{DynamicResource FaderGrooveBg}" BorderBrush="{DynamicResource FaderGrooveRim}"
                                                                    BorderThickness="1" Opacity="0" />
                                                            <Slider Style="{DynamicResource FaderV}" Height="130" Orientation="Vertical"
                                                                    Minimum="0" Maximum="100" Value="{Binding VolumeDisplay, Mode=OneWay}"
                                                                    Loaded="OnChannelFaderLoaded"
                                                                    MouseEnter="OnChannelFaderMouseEnter"
                                                                    MouseLeave="OnChannelFaderMouseLeave"
                                                                    PreviewMouseWheel="OnChannelFaderMouseWheel"
                                                                    HorizontalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding VolumeDisplay, StringFormat={}{0:F0}%}" FontFamily="Consolas" FontSize="{DynamicResource Fz.Small}"
                                                                   Height="18" Foreground="{DynamicResource TextSecondary}"
                                                                   Margin="0,6,0,0" TextAlignment="Center" />
                                                        <Button Content="{Binding MuteText}" Width="76" Margin="0,8,0,0"
                                                                Style="{DynamicResource BtnFlat}" Click="OnChannelMuteClick" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 音量曲线：百分比＝推子位置，实际振幅按曲线映射（对数为等响度，可自定义） -->
                            <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="2,14,2,0" />
                            <Grid Margin="2,11,2,0" ToolTip="{DynamicResource S.Curve.Tooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Curve.Title}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <ComboBox x:Name="VolumeCurveCombo" Grid.Column="1" Style="{DynamicResource Combo}"
                                          Width="150" Margin="14,0,0,0" VerticalAlignment="Center"
                                          SelectionChanged="OnVolumeCurveChanged">
                                    <ComboBoxItem Content="{DynamicResource S.Curve.Linear}" />
                                    <ComboBoxItem Content="{DynamicResource S.Curve.Square}" />
                                    <ComboBoxItem Content="{DynamicResource S.Curve.Log}" />
                                    <ComboBoxItem Content="{DynamicResource S.Curve.Custom}" />
                                </ComboBox>
                                <TextBlock x:Name="VolumeCurveHint" Grid.Column="2" Style="{DynamicResource Hint}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="330" />
                            </Grid>
                            <controls:CurveChart x:Name="CurveChartBox" Height="136" Margin="36,10,6,2"
                                                 HorizontalAlignment="Stretch"
                                                 CurveEdited="OnCurveChartEdited" />
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 分组 ═══ -->
            <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Tab.Groups}" Margin="9,0,0,0" />
                        </StackPanel>
                    </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <Button DockPanel.Dock="Bottom" Content="{DynamicResource S.Group.New}" Style="{DynamicResource BtnPrimary}"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="OnGroupAdd" />
                        <ListBox x:Name="GroupList" Style="{DynamicResource CardList}"
                                 SelectionChanged="OnGroupSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Group.Name}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource Rad.Chip}"
                                                        Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding DefaultVisibility}">
                                                    <TextBlock Text="{DynamicResource S.Group.DefaultBadge}" FontSize="{DynamicResource Fz.Micro}" Foreground="{DynamicResource Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CountText}" FontSize="{DynamicResource Fz.Micro}"
                                                       Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="{DynamicResource M.Card}">
                        <Grid MaxWidth="760" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 组名 + 默认组（? 图标悬停看说明） -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Group.Name}" Style="{DynamicResource Label}" />
                                    <TextBox x:Name="GroupNameBox" Style="{DynamicResource Tb}" Margin="0,6,0,0"
                                             HorizontalAlignment="Stretch" MaxWidth="320"
                                             LostFocus="OnGroupNameChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="DefaultCheck" Content="{DynamicResource S.Group.SetDefault}"
                                              VerticalAlignment="Center"
                                              PreviewMouseLeftButtonUp="OnDefaultCheckGuard"
                                              PreviewKeyDown="OnDefaultCheckKeyGuard"
                                              Checked="OnDefaultChanged" Unchecked="OnDefaultChanged" />
                                    <Border Width="17" Height="17" CornerRadius="{DynamicResource Rad.Card}" Margin="8,0,0,0"
                                            BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1"
                                            Background="Transparent" VerticalAlignment="Center" Cursor="Hand"
                                            ToolTipService.InitialShowDelay="150">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="?" FontSize="{DynamicResource Fz.Micro}" Foreground="{DynamicResource TextFaint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="430" LineHeight="17"
                                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource Fz.Small}">
                                                    <Run Text="{DynamicResource S.Group.DefaultTip1}" />
                                                    <LineBreak />
                                                    <Run Text="{DynamicResource S.Group.DefaultTip2}" />
                                                    <LineBreak />
                                                    <Run Text="{DynamicResource S.Group.DefaultTip3}" />
                                                </TextBlock>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 区块一：进程匹配（已加入的进程） -->
                            <Border Grid.Row="1" Background="{DynamicResource PageBg}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Rad.Card}" Padding="14,12" Margin="{DynamicResource M.Section}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Group.ProcMatch}" FontSize="{DynamicResource Fz.Base}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{DynamicResource S.Group.ProcMatchHint}"
                                               Style="{DynamicResource Hint}" Margin="0,4,0,10" />
                                    <TextBlock x:Name="GroupProcEmpty" Text="{DynamicResource S.Group.ProcEmpty}"
                                               Style="{DynamicResource Hint}" Margin="0,2,0,2" />
                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="GroupProcesses">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ItemHover}"
                                                            CornerRadius="{DynamicResource Rad.Control}" Padding="9,4" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding}" FontSize="{DynamicResource Fz.Base}"
                                                                       Foreground="{DynamicResource TextPrimary}" />
                                                            <Button Content="✕" Style="{DynamicResource BtnDanger}" FontSize="{DynamicResource Fz.Micro}"
                                                                    Padding="5,0" Margin="8,0,0,0" BorderThickness="0"
                                                                    Background="Transparent" Tag="{Binding}"
                                                                    Click="OnProcRemoveItem"
                                                                    ToolTip="{DynamicResource S.Group.RemoveProcTip}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- 区块二：添加操作 -->
                            <Border Grid.Row="2" Background="{DynamicResource PageBg}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Rad.Card}" Padding="14,12" Margin="{DynamicResource M.Row}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S.Group.AddProc}" FontSize="{DynamicResource Fz.Base}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Grid Margin="{DynamicResource M.Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewProcBox" Style="{DynamicResource Tb}"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="OnProcBoxKeyDown" />
                                        <Button Grid.Column="1" Content="{DynamicResource S.Group.Add}" Style="{DynamicResource Btn}" Margin="8,0,0,0"
                                                Click="OnProcAdd" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource S.Group.FromRunning}" FontSize="{DynamicResource Fz.Micro}"
                                               Foreground="{DynamicResource TextFaint}" Margin="{DynamicResource M.Row}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="RunningProcs" Style="{DynamicResource Combo}" MaxWidth="280" />
                                        <Button Grid.Column="1" Content="{DynamicResource S.Group.Refresh}" Style="{DynamicResource Btn}" Margin="8,0,0,0"
                                                Click="OnRefreshRunning" />
                                        <Button Grid.Column="2" Content="{DynamicResource S.Group.AddSelected}" Style="{DynamicResource BtnPrimary}" Margin="8,0,0,0"
                                                Click="OnProcAddRunning"
                                                ToolTip="{DynamicResource S.Group.AddSelectedTip}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Text="{DynamicResource S.Group.BrowserHint}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="{DynamicResource S.Group.Delete}" Style="{DynamicResource BtnDanger}"
                                        VerticalAlignment="Center" Click="OnGroupDelete" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 规则 ═══ -->
            <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Tab.Rules}" Margin="9,0,0,0" />
                        </StackPanel>
                    </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="335" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <Button DockPanel.Dock="Bottom" Content="{DynamicResource S.Rule.New}" Style="{DynamicResource BtnPrimary}"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="OnRuleAdd" />
                        <ListBox x:Name="RuleList" Style="{DynamicResource CardList}"
                                 SelectionChanged="OnRuleSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Sentence}" FontSize="{DynamicResource Fz.Base}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <!-- 失配提醒：触发/目标引用当前匹配不上任何会话时随行出现（正常运行时不可见） -->
                                            <TextBlock Text="{Binding WarnText}" FontSize="{DynamicResource Fz.Micro}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" Foreground="#D97706"
                                                       Visibility="{Binding WarnVisibility}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Rule.Enabled}"
                                                  Style="{DynamicResource Switch}" VerticalAlignment="Center"
                                                  Checked="OnRuleToggle"
                                                  Unchecked="OnRuleToggle" ToolTip="{DynamicResource S.Rule.ToggleTip}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 编辑面板内容限宽并居中：小窗自然铺满，宽窗口聚拢居中（避免内容贴左+右侧大片空白）；
                         外包 ScrollViewer：最小窗口高度放不下全部字段时可滚动（此前下半段直接不可见） -->
                    <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="{DynamicResource M.Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                       Text="{DynamicResource S.Rule.Header}" />

                            <!-- ① 关系：谁触发、压谁 -->
                            <TextBlock Text="{DynamicResource S.Rule.SecRelation}" Margin="0,16,0,0"
                                       FontSize="{DynamicResource Fz.Micro}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentFg}" />
                            <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,6,0,0" />

                            <!-- 值下拉一律左对齐：Stretch+MaxWidth 组合会被居中排布，宽窗口时控件漂在列中间、两侧留大空洞 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Rule.Trigger}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="RuleTriggerType" Style="{DynamicResource Combo}"
                                          Width="90" SelectionChanged="OnRuleSelectorTypeChanged">
                                    <ComboBoxItem Content="{DynamicResource S.Rule.SelGroup}" />
                                    <ComboBoxItem Content="{DynamicResource S.Rule.SelApp}" />
                                </ComboBox>
                                <ComboBox Grid.Row="0" Grid.Column="2" x:Name="RuleTriggerValue" Style="{DynamicResource Combo}"
                                          HorizontalAlignment="Left" MaxWidth="360" MinWidth="110" Margin="8,0,0,0" IsEditable="True"
                                          SelectionChanged="OnRuleSelectorChanged"
                                          ToolTip="{DynamicResource S.Rule.TriggerValueTip}" />
                                <TextBlock x:Name="RuleTriggerHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Style="{DynamicResource Hint}" FontSize="{DynamicResource Fz.Micro}" Margin="8,4,0,0" MaxWidth="430"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Rule.Target}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="RuleTargetType" Style="{DynamicResource Combo}"
                                          Width="90" SelectionChanged="OnRuleSelectorTypeChanged">
                                    <ComboBoxItem Content="{DynamicResource S.Rule.SelGroup}" />
                                    <ComboBoxItem Content="{DynamicResource S.Rule.SelApp}" />
                                </ComboBox>
                                <ComboBox Grid.Row="0" Grid.Column="2" x:Name="RuleTargetValue" Style="{DynamicResource Combo}"
                                          HorizontalAlignment="Left" MaxWidth="360" MinWidth="110" Margin="8,0,0,0" IsEditable="True"
                                          SelectionChanged="OnRuleSelectorChanged" />
                                <TextBlock x:Name="RuleTargetHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Style="{DynamicResource Hint}" FontSize="{DynamicResource Fz.Micro}" Margin="8,4,0,0" MaxWidth="430"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </Grid>

                            <!-- ② 效果：压到多少、多快 -->
                            <TextBlock Text="{DynamicResource S.Rule.SecEffect}" Margin="0,16,0,0"
                                       FontSize="{DynamicResource Fz.Micro}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentFg}" />
                            <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,6,0,0" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Rule.TargetVolume}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="RuleVolume" Style="{DynamicResource Tb}" Width="80"
                                             TextChanged="OnRuleFieldChanged" />
                                    <TextBlock Text="0 - 100" Style="{DynamicResource Hint}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Rule.Priority}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                           ToolTip="{DynamicResource S.Rule.PriorityHint}" />
                                <TextBox Grid.Column="1" x:Name="RulePriority" Style="{DynamicResource Tb}"
                                         Width="80" HorizontalAlignment="Left" TextChanged="OnRuleFieldChanged" />
                            </Grid>

                            <!-- 规则级闪避节奏覆盖：留空跟随设置页全局值 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Rule.Rhythm}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                           ToolTip="{DynamicResource S.Rule.RhythmTip}" />
                                <!-- WrapPanel：窄窗口放不下时"恢复"一组自动换行，绝不裁字 -->
                                <WrapPanel Grid.Column="1">
                                    <TextBox x:Name="RuleFadeOut" Style="{DynamicResource Tb}" Width="64"
                                             TextChanged="OnRuleFieldChanged" ToolTip="{DynamicResource S.Rule.FadeOutTooltip}" />
                                    <TextBlock Text="{DynamicResource S.Rule.FadeOutMs}" Style="{DynamicResource Hint}"
                                               VerticalAlignment="Center" Margin="6,0,14,0" />
                                    <TextBox x:Name="RuleFadeIn" Style="{DynamicResource Tb}" Width="64" Margin="0,0,0,0"
                                             TextChanged="OnRuleFieldChanged" ToolTip="{DynamicResource S.Rule.FadeInTooltip}" />
                                    <TextBlock Text="{DynamicResource S.Rule.FadeInMs}" Style="{DynamicResource Hint}"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </WrapPanel>
                            </Grid>

                            <!-- ③ 条件：何时生效 -->
                            <TextBlock Text="{DynamicResource S.Rule.SecCondition}" Margin="0,16,0,0"
                                       FontSize="{DynamicResource Fz.Micro}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentFg}" />
                            <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,6,0,0" />

                            <!-- 生效条件（最小版：设备条件）——设备下拉独立一行占满，窄窗口放得下长设备名 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Rule.Condition}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                           ToolTip="{DynamicResource S.Rule.ConditionTip}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="RuleCondType" Style="{DynamicResource Combo}"
                                          Width="130" HorizontalAlignment="Left" SelectionChanged="OnRuleCondTypeChanged">
                                    <ComboBoxItem Content="{DynamicResource S.Rule.CondNone}" />
                                    <ComboBoxItem Content="{DynamicResource S.Rule.CondDevice}" />
                                </ComboBox>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RuleCondDevice" Style="{DynamicResource Combo}"
                                          IsEditable="True" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                          MaxWidth="360" Visibility="Collapsed"
                                          primitives:TextBoxBase.TextChanged="OnRuleFieldChanged"
                                          SelectionChanged="OnRuleFieldChanged"
                                          ToolTip="{DynamicResource S.Rule.CondDeviceTip}" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource S.Rule.Detection}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                           ToolTip="{DynamicResource S.Rule.DetectionTip}" />
                                <ComboBox Grid.Column="1" x:Name="RuleDetectionMode" Style="{DynamicResource Combo}"
                                          HorizontalAlignment="Left" Width="220" MinWidth="96"
                                          SelectedIndex="0" SelectionChanged="OnRuleFieldChanged"
                                          ToolTip="{DynamicResource S.Rule.DetectionTip}">
                                    <ComboBoxItem Content="{DynamicResource S.Rule.DetectState}" />
                                    <ComboBoxItem Content="{DynamicResource S.Rule.DetectSound}" />
                                </ComboBox>
                                <CheckBox Grid.Column="2" x:Name="RuleEnabled" Content="{DynamicResource S.Rule.EnableThis}"
                                          Style="{DynamicResource Switch}" Margin="14,0,0,0"
                                          VerticalAlignment="Center"
                                          Checked="OnRuleFieldChanged" Unchecked="OnRuleFieldChanged" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Hint}" Margin="0,0,16,0"
                                           Text="{DynamicResource S.Rule.AutoSaveHint}" />
                                <Button Grid.Column="1" Content="{DynamicResource S.Rule.Delete}" Style="{DynamicResource BtnDanger}"
                                        VerticalAlignment="Center" Click="OnRuleDelete" />
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ 外观 ═══ -->
            <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Tab.Appearance}" Margin="9,0,0,0" />
                        </StackPanel>
                    </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center">

                        <!-- 实时预览：所有外观改动在这里即时可见 -->
                        <Border Style="{DynamicResource Card}" Padding="{DynamicResource M.Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Ap.PreviewTitle}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource S.Ap.SamplePrimary}" Style="{DynamicResource BtnPrimary}" />
                                            <Button Content="{DynamicResource S.Ap.SampleBtn}" Style="{DynamicResource Btn}" Margin="8,0,0,0" />
                                            <CheckBox IsChecked="True" Content="{DynamicResource S.Ap.SampleSwitch}" Style="{DynamicResource Switch}" Margin="14,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Ap.SampleText}" FontSize="{DynamicResource Fz.Body}"
                                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource S.Ap.SampleHint}" Style="{DynamicResource Hint}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="63%" FontFamily="Consolas" FontSize="{DynamicResource Fz.Num}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <controls:LedMeter Height="10" Width="90" Segments="12" Value="62" VerticalAlignment="Center" />
                                        <Slider Style="{DynamicResource FaderV}" Orientation="Vertical" Height="64" Value="60" Margin="14,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 外观设置行（主流全量：主题/强调色/字号/密度/圆角/动效/语言） -->
                        <Border Style="{DynamicResource Card}" Padding="{DynamicResource M.Card}" Margin="{DynamicResource M.Row}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Ap.Title}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Ap.Theme}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="ThemeCombo" Style="{DynamicResource Combo}"
                                              Width="180" HorizontalAlignment="Left" SelectionChanged="OnAppearancePrefChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Ap.ThemeDark}" />
                                        <ComboBoxItem Content="{DynamicResource S.Ap.ThemeLight}" />
                                        <ComboBoxItem Content="{DynamicResource S.Ap.ThemeSystem}" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Ap.Accent}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Ap.AccentTip}" />
                                    <WrapPanel x:Name="AccentPanel" Grid.Column="1" Orientation="Horizontal" />
                                </Grid>

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Ap.FontScale}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="FontScaleCombo" Style="{DynamicResource Combo}"
                                              Width="180" HorizontalAlignment="Left" SelectionChanged="OnAppearancePrefChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Ap.ScaleSmall}" />
                                        <ComboBoxItem Content="{DynamicResource S.Ap.ScaleStandard}" />
                                        <ComboBoxItem Content="{DynamicResource S.Ap.ScaleLarge}" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Ap.Density}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="DensityCombo" Style="{DynamicResource Combo}"
                                              Width="180" HorizontalAlignment="Left" SelectionChanged="OnAppearancePrefChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Ap.DensityComfortable}" />
                                        <ComboBoxItem Content="{DynamicResource S.Ap.DensityCompact}" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Ap.Radius}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="RadiusCombo" Style="{DynamicResource Combo}"
                                              Width="180" HorizontalAlignment="Left" SelectionChanged="OnAppearancePrefChanged">
                                        <ComboBoxItem Content="{DynamicResource S.Ap.RadiusSharp}" />
                                        <ComboBoxItem Content="{DynamicResource S.Ap.RadiusSoft}" />
                                        <ComboBoxItem Content="{DynamicResource S.Ap.RadiusRound}" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Ap.Animations}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Ap.AnimationsTip}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox x:Name="AnimToggle" Style="{DynamicResource Switch}"
                                                  Checked="OnAnimToggleChanged" Unchecked="OnAnimToggleChanged" />
                                        <TextBlock Text="{DynamicResource S.Ap.AnimationsHint}"
                                                   Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,18,0,0" />

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.Language}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Set.LanguageHint}" />
                                    <ComboBox Grid.Column="1" x:Name="SetLanguage" Style="{DynamicResource Combo}"
                                              Width="180" HorizontalAlignment="Left"
                                              SelectionChanged="OnLanguageChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 设置 ═══ -->
            <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Fz.Stat}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Tab.Settings}" Margin="9,0,0,0" />
                        </StackPanel>
                    </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center">

                        <!-- 单卡分组式设置（系统设置风格）：分组以发丝线分隔 -->
                        <Border Style="{DynamicResource Card}" Padding="{DynamicResource M.Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Set.Run}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.Suspend}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Set.SuspendTip}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox x:Name="SetSuspend" Style="{DynamicResource Switch}"
                                                  Checked="OnSuspendSwitchChanged" Unchecked="OnSuspendSwitchChanged"
                                                  ToolTip="{DynamicResource S.Set.SuspendSwitchTip}" />
                                        <TextBlock Text="{DynamicResource S.Set.SuspendOffHint}"
                                                   Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.RuleConflict}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Set.RuleConflictTip}" />
                                    <ComboBox Grid.Column="1" x:Name="SetRuleConflict" Style="{DynamicResource Combo}"
                                              Width="230" HorizontalAlignment="Left"
                                              SelectionChanged="OnSettingsFieldChanged" />
                                </Grid>
                                <TextBlock x:Name="SetRuleConflictHint"
                                           Text="{DynamicResource S.Set.RuleConflictHint}"
                                           Style="{DynamicResource Hint}" Margin="0,8,0,0" />

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.Takeover}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Set.TakeoverTip}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox x:Name="SetManualTakeover" Style="{DynamicResource Switch}"
                                                  Checked="OnSettingsFieldChanged" Unchecked="OnSettingsFieldChanged" />
                                        <TextBlock Text="{DynamicResource S.Set.TakeoverHint}"
                                                   Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.Hotkeys}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Set.HotkeysTip}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox x:Name="SetHotkeys" Style="{DynamicResource Switch}"
                                                  Checked="OnSettingsFieldChanged" Unchecked="OnSettingsFieldChanged" />
                                        <TextBlock Text="{DynamicResource S.Set.HotkeysHint}"
                                                   Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="{DynamicResource M.Section}" />

                                <TextBlock Text="{DynamicResource S.Set.Detect}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource M.Section}" />
                                <CheckBox x:Name="SetUseSmtc" Content="{DynamicResource S.Set.Smtc}"
                                          Margin="0,14,0,0" HorizontalAlignment="Left"
                                          Checked="OnSettingsFieldChanged" Unchecked="OnSettingsFieldChanged" />
                                <TextBlock Text="{DynamicResource S.Set.SmtcHint}"
                                           Style="{DynamicResource Hint}" Margin="0,10,0,0" />

                                <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="{DynamicResource M.Section}" />

                                <TextBlock Text="{DynamicResource S.Set.Fade}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource M.Section}" />
                                <TextBlock Text="{DynamicResource S.Set.FadeHint}"
                                           Style="{DynamicResource Hint}" Margin="0,6,0,0" />
                                <Grid Margin="{DynamicResource M.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.FadeOutLabel}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetFadeOut" Style="{DynamicResource Tb}" Width="80"
                                             TextChanged="OnSettingsFieldChanged" />
                                    <TextBlock Grid.Column="2" ToolTip="{DynamicResource S.Set.FadeOutHint}"
                                               Text="{DynamicResource S.Set.FadeOutHint}"
                                               Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="{DynamicResource M.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.FadeInLabel}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetFadeIn" Style="{DynamicResource Tb}" Width="80"
                                             TextChanged="OnSettingsFieldChanged" />
                                    <TextBlock Grid.Column="2" ToolTip="{DynamicResource S.Set.FadeInHint}"
                                               Text="{DynamicResource S.Set.FadeInHint}"
                                               Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="{DynamicResource M.Section}" />

                                <TextBlock Text="{DynamicResource S.Set.Perf}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource M.Section}" />
                                <Grid Margin="{DynamicResource M.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.Poll}" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetPoll" Style="{DynamicResource Tb}" Width="80"
                                             TextChanged="OnSettingsFieldChanged" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource S.Set.PollHint}"
                                               Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="{DynamicResource M.Section}" />

                                <TextBlock Text="{DynamicResource S.Set.Startup}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="{DynamicResource M.Section}" />
                                <CheckBox x:Name="SetAutoStart" Content="{DynamicResource S.Set.AutoStart}"
                                          Margin="{DynamicResource M.Section}" HorizontalAlignment="Left"
                                          Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"
                                          ToolTip="{DynamicResource S.Set.AutoStartTip}" />
                                <TextBlock Style="{DynamicResource Hint}" Margin="{DynamicResource M.Row}"
                                           Text="{DynamicResource S.Set.AutoStartHint}" />
                            </StackPanel>
                        </Border>

                        <!-- 配置管理：导入/导出 + 存储位置（便携模式） -->
                        <Border Style="{DynamicResource Card}" Padding="{DynamicResource M.Card}" Margin="{DynamicResource M.Row}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Set.Config}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.ImportExport}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Set.ImportExportTip}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{DynamicResource S.Set.Export}" Style="{DynamicResource Btn}" Padding="14,5"
                                                Click="OnConfigExport" />
                                        <Button Content="{DynamicResource S.Set.Import}" Style="{DynamicResource Btn}" Padding="14,5"
                                                Margin="8,0,0,0" Click="OnConfigImport"
                                                ToolTip="{DynamicResource S.Set.ImportTip}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ConfigPathText" Style="{DynamicResource Hint}" Margin="{DynamicResource M.Row}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="PortableModeText" Style="{DynamicResource Hint}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 关于 + 更新检查（仅提示，不自动下载；链接以文字展示，不拉起浏览器） -->
                        <Border Style="{DynamicResource Card}" Padding="{DynamicResource M.Card}" Margin="{DynamicResource M.Row}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Set.About}" FontSize="{DynamicResource Fz.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <Grid Margin="{DynamicResource M.Section}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.CheckUpdate}" Style="{DynamicResource Label}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource S.Set.CheckUpdateTip}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="UpdateCheckButton" Content="{DynamicResource S.Set.CheckUpdate}" Style="{DynamicResource Btn}"
                                                Padding="14,5" Click="OnCheckUpdate" />
                                        <TextBlock x:Name="UpdateStatusText" Text="{DynamicResource S.Set.UpdateInitialHint}"
                                                   Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{DynamicResource Hint}" Margin="{DynamicResource M.Row}" TextWrapping="Wrap"
                                           Text="{DynamicResource S.Set.ReleasesHint}" />
                            </StackPanel>
                        </Border>

                        <!-- 诊断自查通道（隐蔽入口）：默认收起、弱化样式，未展开时不占视觉面积。
                             事件只存内存环形缓冲（最近 600 条），完整日志仍在 app.log 文件。 -->
                        <TextBlock x:Name="DiagToggle" Text="{DynamicResource S.Set.DiagToggleClosed}" FontSize="{DynamicResource Fz.Small}" Cursor="Hand"
                                   Foreground="{DynamicResource TextFaint}" Margin="6,12,0,0" Opacity="0.85"
                                   MouseLeftButtonDown="OnDiagToggleClicked"
                                   ToolTip="{DynamicResource S.Set.DiagToggleTip}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border x:Name="DiagPanel" Style="{DynamicResource Card}" Padding="14" Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Set.DiagTitle}" FontSize="{DynamicResource Fz.Base}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{DynamicResource S.Set.DiagCopy}" Style="{DynamicResource Btn}" Padding="10,3"
                                            Click="OnDiagCopy" ToolTip="{DynamicResource S.Set.DiagCopyTip}" />
                                    <Button Grid.Column="2" Content="{DynamicResource S.Set.DiagClear}" Style="{DynamicResource Btn}" Padding="10,3"
                                            Margin="8,0,0,0" Click="OnDiagClear" />
                                </Grid>
                                <TextBox x:Name="DiagBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                                         FontSize="{DynamicResource Fz.Small}" Height="230" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="{DynamicResource PageBg}"
                                         Foreground="{DynamicResource TextSecondary}"
                                         BorderBrush="{DynamicResource FieldBorder}" />
                                <TextBlock x:Name="DiagPathText" Style="{DynamicResource Hint}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底栏 -->
        <DockPanel Grid.Row="2" Margin="2,12,2,0" LastChildFill="False">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="{DynamicResource Fz.Small}"
                       FontFamily="Consolas" Foreground="{DynamicResource TextFaint}" Margin="12,0,0,0" />
            <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="{DynamicResource Fz.Small}"
                       Foreground="{DynamicResource TextSecondary}" />
        </DockPanel>
    </Grid>
</Window>
