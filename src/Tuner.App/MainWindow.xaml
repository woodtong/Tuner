<Window x:Class="Tuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tuner.Controls"
        Title="Tuner — 分组音频闪避" Width="920" Height="660"
        MinWidth="800" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tuner" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="分组音频闪避" FontSize="13" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Bottom" Margin="10,0,0,3" />
            </StackPanel>
            <controls:LedMeter DockPanel.Dock="Right" x:Name="MasterMeter" Width="110" Height="8" Segments="14"
                               VerticalAlignment="Center" Margin="0,0,0,0" ToolTip="设备总峰值" />
            <Border DockPanel.Dock="Right" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14"
                    Padding="11,4" VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceText" Margin="7,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

            <!-- ═══ 实时状态 ═══ -->
            <TabItem Header="实时状态">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="7" Padding="12,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="会话" Style="{StaticResource Label}" />
                                <TextBlock x:Name="StatTotal" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                           Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="7" Padding="12,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                                <TextBlock Text="出声中" Style="{StaticResource Label}" Margin="6,0,0,0" />
                                <TextBlock x:Name="StatSpeaking" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                           Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="7" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Amber}" VerticalAlignment="Center" />
                                <TextBlock Text="闪避中" Style="{StaticResource Label}" Margin="6,0,0,0" />
                                <TextBlock x:Name="StatDucking" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                           Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="StatusList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                                BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,4,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Channel}" FontFamily="Consolas"
                                                           FontSize="11" Foreground="{StaticResource TextFaint}"
                                                           VerticalAlignment="Top" Margin="2,1,10,0" />

                                                <Ellipse Grid.Column="1" Width="9" Height="9"
                                                         Fill="{Binding SpeakingBrush}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Process}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding PidText}" FontSize="10.5" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="3" Background="{Binding GroupBrush}" CornerRadius="4"
                                                        Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding GroupName}" FontSize="11" Foreground="White" />
                                                </Border>

                                                <StackPanel Grid.Column="4" Width="132" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="PEAK" FontSize="9.5" Foreground="{StaticResource TextFaint}" />
                                                    <controls:LedMeter Height="10" Segments="12" Margin="0,3,0,0"
                                                                       Value="{Binding PeakPercent}" />
                                                </StackPanel>

                                                <Border Grid.Column="5" Background="{StaticResource AmberSoft}"
                                                        BorderBrush="#5A2626" BorderThickness="1" CornerRadius="4"
                                                        Padding="8,3" VerticalAlignment="Center" Margin="0,0,14,0"
                                                        Visibility="{Binding DuckVisibility}">
                                                    <TextBlock Text="{Binding DuckText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AmberText}" />
                                                </Border>

                                                <StackPanel Grid.Column="6" Width="188" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:LedMeter Grid.Column="0" Height="12" Segments="16"
                                                                           Value="{Binding VolumePercent}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding VolumeText}" FontSize="12"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Margin="8,0,0,0" MinWidth="40" TextAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding OriginalText}" FontSize="10.5"
                                                               Foreground="{StaticResource TextFaint}" Margin="0,3,0,0"
                                                               TextAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="StatusEmpty" Text="暂无音频会话 — 让任意应用播放声音后会自动出现在这里"
                                       HorizontalAlignment="Center" Margin="0,60,0,0" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══ 音量（输出混音台） ═══ -->
            <TabItem Header="音量">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,4,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主输出" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="MasterSlider" Style="{StaticResource Fader}"
                                    Width="280" Minimum="0" Maximum="100" Margin="20,0,0,0"
                                    VerticalAlignment="Center" ValueChanged="OnMasterVolumeChanged" />
                            <TextBlock Grid.Column="2" x:Name="MasterVolText" FontFamily="Consolas" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" MinWidth="46" />
                            <controls:LedMeter Grid.Column="3" x:Name="MasterMeterBig" Width="170" Height="14"
                                               Segments="20" VerticalAlignment="Center" Margin="16,0,0,0"
                                               ToolTip="设备总峰值" />
                            <Button Grid.Column="4" x:Name="MasterMuteBtn" Style="{StaticResource Btn}" Width="86"
                                    Margin="16,0,0,0" Click="OnMasterMuteClick" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VolumeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,4,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding PidText}" FontSize="10.5" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{Binding GroupBrush}" CornerRadius="4"
                                                    Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding GroupName}" FontSize="11" Foreground="White" />
                                            </Border>
                                            <controls:LedMeter Grid.Column="2" Height="10" Segments="14"
                                                               Value="{Binding PeakPercent}" VerticalAlignment="Center"
                                                               Margin="0,0,14,0" Width="130" />
                                            <Slider Grid.Column="3" Style="{StaticResource Fader}"
                                                    Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    Value="{Binding VolumePercent}"
                                                    ValueChanged="OnChannelVolumeChanged" />
                                            <TextBlock Grid.Column="4" Text="{Binding VolumeText}" FontFamily="Consolas"
                                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center" Margin="8,0,10,0" MinWidth="40"
                                                       TextAlignment="Right" />
                                            <Button Grid.Column="5" Content="{Binding MuteText}" Width="76"
                                                    Style="{StaticResource Btn}" Click="OnChannelMuteClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══ 分组 ═══ -->
            <TabItem Header="分组">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <Button DockPanel.Dock="Bottom" Content="＋ 新建分组" Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="OnGroupAdd" />
                        <ListBox x:Name="GroupList" Style="{StaticResource CardList}"
                                 SelectionChanged="OnGroupSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Group.Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <Border Background="{StaticResource AccentSoft}" CornerRadius="4"
                                                        Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding DefaultVisibility}">
                                                    <TextBlock Text="默认" FontSize="10.5" Foreground="{StaticResource Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CountText}" FontSize="11"
                                                       Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="组名" Style="{StaticResource Label}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox x:Name="GroupNameBox" Style="{StaticResource Tb}" Width="260"
                                             LostFocus="OnGroupNameChanged" />
                                    <CheckBox x:Name="DefaultCheck" Content="设为默认组" Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              ToolTip="未命中任何分组规则的进程自动归入默认组"
                                              Checked="OnDefaultChanged" Unchecked="OnDefaultChanged" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,18,0,6">
                                <TextBlock Text="进程匹配" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="按进程名匹配，不区分大小写；填 system sounds 可匹配系统提示音"
                                           Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl Grid.Row="2" x:Name="GroupProcesses" MaxHeight="150"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PageBg}" CornerRadius="5"
                                                Padding="9,4" Margin="0,0,6,6" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <Button Content="✕" Style="{StaticResource BtnDanger}" FontSize="10.5"
                                                        Padding="5,0" Margin="8,0,0,0" BorderThickness="0"
                                                        Background="Transparent" Tag="{Binding}"
                                                        Click="OnProcRemoveItem"
                                                        ToolTip="从本分组移除该进程" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBox x:Name="NewProcBox" Style="{StaticResource Tb}" Width="220"
                                         VerticalContentAlignment="Center"
                                         KeyDown="OnProcBoxKeyDown" />
                                <Button Content="添加" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                        Click="OnProcAdd" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="从运行中的应用添加（预注册）" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,18,0,6" />

                            <StackPanel Grid.Row="5" Orientation="Horizontal">
                                <ComboBox x:Name="RunningProcs" Style="{StaticResource Combo}" Width="220" />
                                <Button Content="刷新" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                        Click="OnRefreshRunning" />
                                <Button Content="添加选中" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                        Click="OnProcAddRunning"
                                        ToolTip="该应用的音频会话一旦出现，立即按本分组规则处理" />
                            </StackPanel>

                            <DockPanel Grid.Row="7" LastChildFill="False">
                                <TextBlock Style="{StaticResource Hint}" MaxWidth="380" VerticalAlignment="Center"
                                           Text="提示：浏览器各标签页共享一个会话，只能按整个浏览器分组；独占模式 / ASIO 音频无法检测。" />
                                <Button DockPanel.Dock="Right" Content="删除分组" Style="{StaticResource BtnDanger}"
                                        Click="OnGroupDelete" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ 规则 ═══ -->
            <TabItem Header="规则">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <Button DockPanel.Dock="Bottom" Content="＋ 新增规则" Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="OnRuleAdd" />
                        <ListBox x:Name="RuleList" Style="{StaticResource CardList}"
                                 SelectionChanged="OnRuleSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Sentence}" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Rule.Enabled}"
                                                  VerticalAlignment="Center" Checked="OnRuleToggle"
                                                  Unchecked="OnRuleToggle" ToolTip="启用 / 停用此规则" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="当【触发】出声或在播时，【目标】的音量渐变到目标值（触发/目标均支持分组或单个应用）" />

                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="触发" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="RuleTriggerType" Style="{StaticResource Combo}"
                                          Width="90" SelectionChanged="OnRuleSelectorTypeChanged">
                                    <ComboBoxItem>分组</ComboBoxItem>
                                    <ComboBoxItem>应用</ComboBoxItem>
                                </ComboBox>
                                <ComboBox Grid.Column="2" x:Name="RuleTriggerValue" Style="{StaticResource Combo}"
                                          Width="210" HorizontalAlignment="Left" Margin="8,0,0,0" IsEditable="True"
                                          SelectionChanged="OnRuleSelectorChanged"
                                          ToolTip="分组=按分组成员匹配；应用=精确到单个进程（可直接输入进程名，无需已运行）" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="RuleTargetType" Style="{StaticResource Combo}"
                                          Width="90" SelectionChanged="OnRuleSelectorTypeChanged">
                                    <ComboBoxItem>分组</ComboBoxItem>
                                    <ComboBoxItem>应用</ComboBoxItem>
                                </ComboBox>
                                <ComboBox Grid.Column="2" x:Name="RuleTargetValue" Style="{StaticResource Combo}"
                                          Width="210" HorizontalAlignment="Left" Margin="8,0,0,0" IsEditable="True"
                                          SelectionChanged="OnRuleSelectorChanged" />
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标音量 %" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="RuleVolume" Style="{StaticResource Tb}" Width="80"
                                             TextChanged="OnRuleFieldChanged" />
                                    <TextBlock Text="0 - 100" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="优先级" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="RulePriority" Style="{StaticResource Tb}" Width="80"
                                             TextChanged="OnRuleFieldChanged" />
                                    <TextBlock Text="同一目标组有多条规则同时生效时，取优先级最高的一条"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               MaxWidth="430" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Grid.Row="5" x:Name="RuleEnabled" Content="启用此规则" Margin="110,16,0,0"
                                      HorizontalAlignment="Left" Checked="OnRuleFieldChanged"
                                      Unchecked="OnRuleFieldChanged" />

                            <DockPanel Grid.Row="7" LastChildFill="False">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}"
                                           Text="规则修改后点击右下角「应用并保存」立即生效并持久化。" />
                                <Button DockPanel.Dock="Right" Content="删除规则" Style="{StaticResource BtnDanger}"
                                        Click="OnRuleDelete" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ 设置 ═══ -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="出声判定" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="进入阈值 %" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetActive" Style="{StaticResource Tb}" Width="80" />
                                    <TextBlock Grid.Column="2" Text="会话峰值超过该值判定为「出声」"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="退出阈值 %" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetInactive" Style="{StaticResource Tb}" Width="80" />
                                    <TextBlock Grid.Column="2" Text="低于进入阈值构成迟滞带，防止临界抖动"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            <CheckBox x:Name="SetUseSmtc" Content="优先使用系统媒体播放状态判定（推荐：歌间静音不误判，停止/暂停立即恢复）"
                                      Margin="0,14,0,0" />

                            <Grid Grid.Row="6" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="低电平保持 ms" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="SetHold" Style="{StaticResource Tb}" Width="80" />
                                <TextBlock Grid.Column="2" Text="峰值持续低于退出阈值此时长才判定停止，防止断续声音导致音量抽搐"
                                           Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="宽限仅对未接入系统媒体会话的应用生效" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="静音宽限（防止把短暂静音误判为停止）" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="宽限 · 音频流仍打开 ms" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetGraceOpen" Style="{StaticResource Tb}" Width="80" />
                                    <TextBlock Grid.Column="2" Text="触发组静音但音频流未关闭（歌曲间隙、淡入淡出）时，保持闪避此时长，默认约 8000"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="宽限 · 音频流已关闭 ms" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetGraceClosed" Style="{StaticResource Tb}" Width="80" />
                                    <TextBlock Grid.Column="2" Text="音频流已关闭（应用真正停止或退出）时的恢复宽限，默认约 1500"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="音量渐变" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="渐变时长 ms" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetFade" Style="{StaticResource Tb}" Width="80" />
                                    <TextBlock Grid.Column="2" Text="全量程（100%→0%）渐变耗时，默认约 1200"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="性能" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="轮询间隔 ms" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SetPoll" Style="{StaticResource Tb}" Width="80" />
                                    <TextBlock Grid.Column="2" Text="会话峰值轮询频率，重启应用后生效"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底栏 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondary}" />
            <Button DockPanel.Dock="Right" Content="应用并保存" Style="{StaticResource BtnPrimary}"
                    Padding="22,8" Click="OnApplySave" />
        </DockPanel>
    </Grid>
</Window>
